# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# custom .gitignore
cache/
output/
wandb/
# Ignore everything in data directory
run_script*

saves/*
!saves/README.md

.gradio

# ==========================================================================
# GBMpro —— 大文件排除 (2026-11-19)
# GitHub 单文件上限 100MB, 仓库软上限 1GB(建议), 以下均为可再生成的产物
# ==========================================================================

# 模型权重 (65GB) —— 从 HuggingFace 重新下载
models/

# LoRA adapter 存档 (11GB) —— 大部分可由 SFT 脚本重训, 但保留 README 说明
saves/*
!saves/README.md

# REINVENT checkpoint (1.9GB) —— 由 configs/reinvent_*.toml 重跑可再生
gbm_project/experiments/reinvent_baseline/*.chkpt

# 原始数据集 (334MB) —— 由 scripts/build_*.py 重建
data/molqa_train.json
data/molqa_drug.json
data/.cache/

# 论文图表中间产物 (可由 matplotlib 重绘)
gbm_project/figures/*.pdf
gbm_project/figures/*.svg

# 运行时缓存
*.tmp
.pytest_cache/

# ---- RL 训练产物 (2026-11-19) ----
# checkpoint 可由训练脚本重新生成, 不入库
*.safetensors
experiments/rl_*/
!experiments/rl_*/train_log.jsonl
!experiments/rl_*/train_config.json
!experiments/rl_*/reward_cache.jsonl
